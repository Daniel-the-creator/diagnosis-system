rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return userDocExists() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
    }

    function hasRole(role) {
      return isAuthenticated() && userDocExists() && getUserData().get('role', '') == role;
    }

    function isAdmin() {
      return isAuthenticated() && userDocExists() &&
        (getUserData().get('role', '') == 'super_admin' ||
         getUserData().get('role', '') == 'hospital_admin');
    }

    function isGateOfficer() {
      return hasRole('gate_officer');
    }

    function isRegistrationOfficer() {
      return hasRole('registration_officer');
    }

    function isDoctor() {
      return hasRole('doctor');
    }

    function isDiagnosticStaff() {
      return hasRole('diagnostic_staff');
    }

    function isAccountOfficer() {
      return hasRole('account_officer');
    }

    function isPharmacist() {
      return hasRole('pharmacist');
    }

    function isAdmissionOfficer() {
      return hasRole('admission_officer');
    }

    function isPatient() {
      return hasRole('patient');
    }

    function isStaff() {
      return isAuthenticated() && userDocExists() &&
        getUserData().get('role', '') in [
          'super_admin', 'hospital_admin',
          'gate_officer', 'registration_officer', 'doctor',
          'diagnostic_staff', 'account_officer', 'pharmacist', 'admission_officer'
        ];
    }

    // ── Users ────────────────────────────────────────────────────
    match /users/{userId} {
      // get: own profile or staff can fetch a specific user
      allow get: if isAuthenticated() &&
        (request.auth.uid == userId || isStaff());
      // list: any authenticated user can query (e.g. patient listing doctors for booking)
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() &&
        (request.auth.uid == userId || isAdmin());
      allow update: if isAdmin() ||
        (request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'active', 'uid']));
      allow delete: if isAdmin();
    }

    // ── Departments ───────────────────────────────────────────────
    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Rooms ─────────────────────────────────────────────────────
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Doctors ───────────────────────────────────────────────────
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Patients ──────────────────────────────────────────────────
    // patientId wildcard = the Firestore document ID (may equal uid for
    // self-registered patients, or a separate ID linked via UserModel.patientId)
    match /patients/{patientId} {
      // get: resource.data is available — check both doc-ID match and field
      allow get: if isStaff() ||
        (isAuthenticated() && (
          request.auth.uid == patientId ||
          resource.data.patientId == request.auth.uid
        ));
      // list (stream/query): resource.data is NOT available — use doc-ID wildcard
      allow list: if isStaff() ||
        (isAuthenticated() && request.auth.uid == patientId);
      allow create: if isStaff() ||
        (isAuthenticated() && request.auth.uid == patientId);
      allow update: if isStaff() ||
        (isAuthenticated() && (
          request.auth.uid == patientId ||
          resource.data.patientId == request.auth.uid
        ));
      allow delete: if isAdmin();
    }

    // ── Visits ───────────────────────────────────────────────────
    match /visits/{visitId} {
      // get: resource.data available
      allow get: if isStaff() ||
        (isAuthenticated() && resource.data.patientId == request.auth.uid);
      // list: patient queries are scoped by .where('patientId') in the app
      allow list: if isStaff() || isAuthenticated();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── Queue Items (Read open to public display / patient tracking) ──
    match /queue_items/{queueId} {
      allow read: if true;
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── Queue Counters ────────────────────────────────────────────
    match /queue_counters/{counterId} {
      allow read, write: if isStaff();
    }

    // ── Consultations ─────────────────────────────────────────────
    match /consultations/{consultationId} {
      allow get: if isStaff() ||
        (isAuthenticated() && resource.data.patientId == request.auth.uid);
      allow list: if isStaff() || isAuthenticated();
      allow create, update: if isDoctor() || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Diagnostic Requests ───────────────────────────────────────
    match /diagnostic_requests/{requestId} {
      allow get: if isStaff() ||
        (isAuthenticated() && resource.data.patientId == request.auth.uid);
      allow list: if isStaff() || isAuthenticated();
      allow create: if isDoctor() || isAdmin();
      allow update: if isDiagnosticStaff() || isDoctor() || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Diagnostic Results (Release gate enforced) ────────────────
    match /diagnostic_results/{resultId} {
      allow get: if isStaff() ||
        (isAuthenticated() &&
         resource.data.patientId == request.auth.uid &&
         resource.data.isReleasedToPatient == true);
      // list: isReleasedToPatient check is enforced via app query filter
      allow list: if isStaff() || (isAuthenticated() && isPatient());
      allow create, update: if isDiagnosticStaff() || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Invoices ──────────────────────────────────────────────────
    match /invoices/{invoiceId} {
      allow get: if isStaff() ||
        (isAuthenticated() && resource.data.patientId == request.auth.uid);
      allow list: if isStaff() || isAuthenticated();
      allow create, update: if isAccountOfficer() || isDoctor() || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Payments ──────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow get: if isStaff() ||
        (isAuthenticated() && resource.data.patientId == request.auth.uid);
      allow list: if isStaff() || isAuthenticated();
      allow create, update: if isAccountOfficer() || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Prescriptions ─────────────────────────────────────────────
    match /prescriptions/{prescriptionId} {
      allow get: if isStaff() ||
        (isAuthenticated() && resource.data.patientId == request.auth.uid);
      allow list: if isStaff() || isAuthenticated();
      allow create: if isDoctor() || isAdmin();
      allow update: if isPharmacist() || isDoctor() || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Medications (Inventory) ───────────────────────────────────
    match /medications/{medicationId} {
      allow read: if isStaff();
      allow write: if isPharmacist() || isAdmin();
    }

    // ── Admissions, Wards, Beds ───────────────────────────────────
    match /admissions/{admissionId} {
      allow get: if isStaff() ||
        (isAuthenticated() && resource.data.patientId == request.auth.uid);
      allow list: if isStaff() || isAuthenticated();
      allow create: if isDoctor() || isAdmin();
      allow update: if isAdmissionOfficer() || isDoctor() || isAdmin();
      allow delete: if isAdmin();
    }

    match /wards/{wardId} {
      allow read: if isStaff();
      allow write: if isAdmissionOfficer() || isAdmin();
    }

    match /beds/{bedId} {
      allow read: if isStaff();
      allow write: if isAdmissionOfficer() || isDoctor() || isAdmin();
    }

    // ── Discharges ────────────────────────────────────────────────
    match /discharges/{dischargeId} {
      allow get: if isStaff() ||
        (isAuthenticated() && resource.data.patientId == request.auth.uid);
      allow list: if isStaff() || isAuthenticated();
      allow create, update: if isDoctor() || isAdmissionOfficer() || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Appointments ──────────────────────────────────────────────
    match /appointments/{appointmentId} {
      // Authenticated patients and staff can read appointments (queries scoped by patientId or doctorId)
      allow read: if isAuthenticated();
      // Any authenticated user can book an appointment
      allow create: if isAuthenticated();
      // Patients can cancel, staff/doctors can confirm, complete, or cancel
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ── Notifications ─────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow get: if isAuthenticated() &&
        (resource.data.recipientId == request.auth.uid || isStaff());
      allow list: if isStaff() || isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── Audit Logs (Phase 3: Immutable Event Trail) ───────────────
    match /audit_logs/{logId} {
      // Read-only for admins and auditors; immutable for all
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false; // strictly immutable audit trail
    }

    // ── Staff Duty Schedules (Phase 3) ─────────────────────────────
    match /staff_schedules/{scheduleId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ── System Settings (Phase 3) ──────────────────────────────────
    match /settings/{docId} {
      allow read: if true; // Public display and patient portal read settings
      allow write: if isAdmin();
    }

    // ── Deny all other paths ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

